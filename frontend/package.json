{
  "name": "mykoknoks-desktop",
  "private": true,
  "version": "1.1.0",
  "description": "MykoKnoks Nordic ecological intelligence desktop application",
  "author": "MykoKnoks / Jarlhalla",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env MYKOKNOKS_DEV_SERVER_URL=http://127.0.0.1:5173 electron electron/main.cjs\"",
    "desktop:build": "node electron/prepare-icon.cjs && npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "h3-js": "^4.3.0",
    "maplibre-gl": "^5.7.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "no.jarlhalla.mykoknoks",
    "productName": "MykoKnoks",
    "asar": true,
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "MykoKnoks-Windows-Setup-v${version}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MykoKnoks"
    }
  }
}
