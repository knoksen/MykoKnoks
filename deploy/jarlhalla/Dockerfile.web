FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install --ignore-scripts
COPY frontend/ ./
ENV MYKOKNOKS_WEB_BASE=/app/
ENV VITE_API_BASE_URL=https://mykoknoks.jarlhalla.com/mykoknoks-api
RUN npm run build

FROM nginx:stable-alpine
COPY deploy/jarlhalla/nginx.container.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/app/
EXPOSE 80
